<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LakouLiv — Accueil</title>
    <script src="https://jsdelivr.net"></script>
    <style>
        .brand-red { color: #DC2626; }
        .bg-brand-red { background-color: #DC2626; }
    </style>
</head>
<body class="bg-black text-white font-sans">

    <!-- HEADER -->
    <header class="border-b border-zinc-800 bg-zinc-950 sticky top-0 z-50 px-4 py-3 flex items-center justify-between">
        <div class="flex items-center space-x-2">
            <span class="text-2xl font-black tracking-wider text-red-600">Lakou<span class="text-white">Liv</span></span>
        </div>
        
        <nav class="hidden md:flex space-x-6 text-sm font-medium">
            <a href="/" class="hover:text-red-500"><%= lang === 'fr' ? 'Accueil' : 'Akèy' %></a>
            <a href="#catalogue" class="hover:text-red-500"><%= lang === 'fr' ? 'Livres' : 'Liv yo' %></a>
            <a href="#categories" class="hover:text-red-500"><%= lang === 'fr' ? 'Catégories' : 'Kategori' %></a>
        </nav>

        <div class="flex items-center space-x-4">
            <div class="bg-zinc-900 border border-zinc-700 rounded px-2 py-1 text-xs flex space-x-2">
                <a href="/lang/fr" class="<%= lang === 'fr' ? 'text-red-500 font-bold' : 'text-zinc-400' %>">FR</a>
                <span class="text-zinc-600">|</span>
                <a href="/lang/kr" class="<%= lang === 'kr' ? 'text-red-500 font-bold' : 'text-zinc-400' %>">KREYÒL</a>
            </div>
            
            <a href="/admin/login" class="text-sm border border-zinc-700 px-3 py-1.5 rounded hover:bg-zinc-900">
                <%= lang === 'fr' ? 'Connexion Admin' : 'Koneksyon Admin' %>
            </a>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="max-w-6xl mx-auto px-4 py-12 md:py-20 text-center">
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-4">
            <%= lang === 'fr' ? 'Découvrez votre prochaine lecture.' : 'Dekouvri pwochen liv w ap li a.' %>
        </h1>
        <p class="text-zinc-400 max-w-2xl mx-auto mb-8 text-sm md:text-base">
            <%= lang === 'fr' ? 'Une bibliothèque numérique pensée pour apprendre, découvrir et évoluer, directement depuis votre téléphone ou votre ordinateur.' : 'Yon bibliyotèk dijital ki fèt pou w aprann, dekouvri epi evolye, dirèkteman sou telefòn ou oswa òdinatè w.' %>
        </p>
        <a href="#catalogue" class="bg-red-600 hover:bg-red-700 text-white font-bold px-6 py-3 rounded-full text-sm transition duration-300">
            <%= lang === 'fr' ? 'Explorer les livres' : 'Gade liv yo' %>
        </a>
        
        <div class="mt-12 w-full h-48 md:h-80 bg-zinc-900 border border-dashed border-zinc-700 rounded-2xl flex items-center justify-center text-zinc-500 text-xs">
            [ Espas pou Imaj / Illustration LakouLiv ]
        </div>
    </section>

    <!-- CATEGORIES -->
    <section id="categories" class="max-w-6xl mx-auto px-4 py-12 border-t border-zinc-900">
        <h2 class="text-2xl font-bold mb-6 flex items-center space-x-2">
            <span class="w-1 h-6 bg-red-600 rounded-full"></span>
            <span><%= lang === 'fr' ? 'Catégories' : 'Kategori yo' %></span>
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <% const cats = lang === 'fr' ? ['Éducation', 'Littérature', 'Histoire', 'Technologie'] : ['Edikasyon', 'Literati', 'Istwa', 'Teknoloji']; %>
            <% cats.forEach(cat => { %>
                <div class="bg-zinc-950 border border-zinc-800 p-4 rounded-xl hover:border-red-600 transition cursor-pointer text-center">
                    <h3 class="font-bold text-sm md:text-base"><%= cat %></h3>
                    <p class="text-xs text-zinc-500 mt-1">0 <%= lang === 'fr' ? 'livre' : 'liv' %></p>
                </div>
            <% }) %>
        </div>
    </section>

    <!-- MARKETPLACE CATALOGUE -->
    <section id="catalogue" class="max-w-6xl mx-auto px-4 py-12 border-t border-zinc-900">
        <h2 class="text-2xl font-bold mb-6 flex items-center space-x-2">
            <span class="w-1 h-6 bg-red-600 rounded-full"></span>
            <span><%= lang === 'fr' ? 'Tous les Livres' : 'Tout liv yo' %></span>
        </h2>

        <% if (books.length === 0) { %>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <% for(let i=0; i<4; i++) { %>
                    <div class="bg-zinc-950 border border-zinc-900 rounded-2xl overflow-hidden opacity-40">
                        <div class="w-full h-48 bg-zinc-900 flex items-center justify-center text-xs text-zinc-600">No Cover</div>
                        <div class="p-3 space-y-2">
                            <div class="h-3 bg-zinc-900 rounded w-3/4"></div>
                            <div class="h-2 bg-zinc-900 rounded w-1/2"></div>
                            <div class="h-4 bg-zinc-900 rounded w-1/3 mt-4"></div>
                        </div>
                    </div>
                <% } %>
            </div>
            <p class="text-center text-zinc-500 text-xs mt-6">
                <%= lang === 'fr' ? "Aucun livre n'est disponible pour le moment. Connectez-vous à l'admin pour en ajouter." : "Pa gen liv ki disponib pou kounye a. Konekte sou admin lan pou w ajoute." %>
            </p>
        <% } else { %>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                <% books.forEach(book => { %>
                    <div class="bg-zinc-950 border border-zinc-800 rounded-2xl overflow-hidden hover:border-zinc-700 transition">
                        <img src="<%= book.coverUrl %>" alt="<%= book.title %>" class="w-full h-48 object-cover">
                        <div class="p-4">
                            <span class="text-[10px] uppercase font-bold text-red-500 bg-red-950/50 px-2 py-0.5 rounded"><%= book.category %></span>
                            <h3 class="font-bold text-sm mt-2 truncate"><%= book.title %></h3>
                            <p class="text-xs text-zinc-400 truncate"><%= book.author %></p>
                            <div class="mt-4 flex items-center justify-between">
                                <span class="font-extrabold text-red-500 text-sm"><%= book.price %> HTG</span>
                                <button class="text-xs bg-white text-black font-bold px-3 py-1.5 rounded-lg hover:bg-zinc-200">Acheter</button>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </section>

    <!-- FOOTER -->
    <footer class="border-t border-zinc-900 bg-zinc-950 text-center py-8 text-xs text-zinc-600">
        <p>© 2026 LakouLiv. Contact: lakouliv@gmail.com</p>
    </footer>

</body>
</html>
